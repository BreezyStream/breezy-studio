{
	"name": "breezy-studio",
	"author": "Jean-Philippe Dery <info@breezy.stream>",
	"productName": "Breezy Studio",
	"version": "0.1.0",
	"description": "The Breezy desktop app, with local AI model training.",
	"homepage": "https://breezy.stream",
	"repository": "github:breezystream/breezy-studio",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit --skipLibCheck",
		"make-icon-mac": "sh ./scripts/make-icon-mac.sh ./build/icons/icon-mac.png ./build/icons",
		"make-icon-win": "sh ./scripts/make-icon-win.sh ./build/icons/icon-win.png ./build/icons",
		"build": "tsc && tsc-alias",
		"start": "tsc && tsc-alias && concurrently \"tsc -w\" \"tsc-alias -w\" \"node scripts/watch.js\"",
		"dist:mac": "electron-builder --mac --publish never",
		"release:mac": ". ~/.config/breezy/notarize.env && npm run build && electron-builder --mac --publish never",
		"dist:win": "electron-builder --win --publish never",
		"release:win": "npm run build && electron-builder --win --publish never",
		"dist": "electron-builder",
		"codegen": "NODE_TLS_REJECT_UNAUTHORIZED=0 graphql-codegen",
		"codegen:watch": "NODE_TLS_REJECT_UNAUTHORIZED=0 graphql-codegen --watch"
	},
	"build": {
		"appId": "stream.breezy.studio",
		"productName": "Breezy Studio",
		"mac": {
			"icon": "build/icons/icon.icns",
			"category": "public.app-category.developer-tools",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"arm64"
					]
				}
			],
			"minimumSystemVersion": "12.0",
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"entitlements": "build/entitlements.mac.plist",
			"entitlementsInherit": "build/entitlements.mac.plist",
			"notarize": true,
			"extraResources": [
				{
					"from": "python/mac/",
					"to": "python/mac/",
					"filter": [
						"**/*"
					]
				},
				{
					"from": "src/object-classification/scripts/",
					"to": "src/object-classification/scripts/",
					"filter": [
						"**/*",
						"!@old/**",
						"!**/__pycache__/**"
					]
				}
			]
		},
		"dmg": {
			"icon": "build/icons/icon.icns"
		},
		"win": {
			"icon": "build/icons/icon.ico",
			"extraResources": [
				{
					"from": "python/win/",
					"to": "python/win/",
					"filter": [
						"**/*"
					]
				},
				{
					"from": "src/object-classification/scripts/",
					"to": "src/object-classification/scripts/",
					"filter": [
						"**/*",
						"!@old/**",
						"!**/__pycache__/**"
					]
				}
			]
		},
		"asar": true,
		"files": [
			"dist/**",
			"!dist/src/**",
			"!dist/js/**",
			"package.json"
		],
		"directories": {
			"buildResources": "build",
			"output": "release"
		},
		"asarUnpack": [
			"**/*.node"
		]
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^7.2.0",
		"@graphql-codegen/near-operation-file-preset": "^5.2.1",
		"@graphql-codegen/typed-document-node": "^7.1.0",
		"@graphql-codegen/typescript": "^6.1.0",
		"@graphql-codegen/typescript-operations": "^6.1.0",
		"@types/apollo-upload-client": "^19.0.0",
		"@types/electron": "^1.6.12",
		"@types/node": "^26.1.1",
		"@types/node-fetch": "^2.6.13",
		"@types/progress-stream": "^2.0.5",
		"chokidar": "^5.0.0",
		"concurrently": "^10.0.3",
		"electron": "^43.1.1",
		"electron-builder": "^26.15.3",
		"tsc-alias": "^1.9.1",
		"typescript": "^6.0.3"
	},
	"optionalDependencies": {
		"fsevents": "^2.3.3"
	},
	"license": "MIT",
	"dependencies": {
		"@apollo/client": "^4.2.7",
		"apollo-upload-client": "^19.0.0",
		"cross-fetch": "^4.1.0",
		"electron-store": "^11.0.2",
		"form-data-encoder": "^4.1.0",
		"graphql": "^16.14.0",
		"node-fetch": "^3.3.2",
		"progress-stream": "^2.0.0"
	}
}
